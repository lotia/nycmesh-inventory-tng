{
  "openapi": "3.1.0",
  "info": {
    "title": "NYC Mesh Inventory",
    "version": "0.1.0"
  },
  "paths": {
    "/api/healthz": {
      "get": {
        "summary": "Healthz",
        "description": "Answers once the database does. db.install() makes a failure a 503.",
        "operationId": "healthz_api_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "The database cannot answer; try again",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnavailableReply"
                }
              }
            }
          }
        }
      }
    },
    "/api/devices": {
      "post": {
        "summary": "Register Device",
        "description": "Register this browser with a code, and give it its cookie.",
        "operationId": "register_device_api_devices_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Registration"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Registered"
                }
              }
            }
          },
          "503": {
            "description": "The database cannot answer; try again",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnavailableReply"
                }
              }
            }
          },
          "400": {
            "description": "The code is not one that registers",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CodeRefusedReply"
                }
              }
            }
          },
          "429": {
            "description": "Too many attempts from here",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RateLimitedReply"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/transactions": {
      "post": {
        "summary": "Save Batch",
        "description": "Write a whole batch, or none of it. A 422 names each bad line, as\nFastAPI's own do: an item, package, location or volunteer that does not\nexist, a fraction of an item counted in each or of a package, a retired\nitem or package received, or an item another line names in the same\npackage, or loose, too (repeated): send each item on one line for each\npackage it is in, sealed, and one loose (docs/decisions/0020).",
        "operationId": "save_batch_api_transactions_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Batch"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Saved"
                }
              }
            }
          },
          "503": {
            "description": "The database cannot answer; try again",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnavailableReply"
                }
              }
            }
          },
          "200": {
            "description": "Already written with this key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Saved"
                }
              }
            }
          },
          "403": {
            "description": "This device is not registered",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceRefusedReply"
                }
              }
            }
          },
          "409": {
            "description": "The key was used for another batch",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KeyReusedReply"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "device": []
          }
        ]
      }
    },
    "/api/catalogue": {
      "get": {
        "summary": "Get Catalogue",
        "description": "Everything current that a cart can hold, and who can fill one; and\nwhich of the batches `key` names are saved.",
        "operationId": "get_catalogue_api_catalogue_get",
        "security": [
          {
            "device": []
          }
        ],
        "parameters": [
          {
            "name": "key",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid"
              },
              "maxItems": 100,
              "default": [],
              "title": "Key"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Catalogue"
                }
              }
            }
          },
          "503": {
            "description": "The database cannot answer; try again",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnavailableReply"
                }
              }
            }
          },
          "403": {
            "description": "This device is not registered",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceRefusedReply"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/telemetry": {
      "post": {
        "summary": "Report",
        "description": "Record what a page reports about itself.",
        "operationId": "report_api_telemetry_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Report"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "503": {
            "description": "The database cannot answer; try again",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnavailableReply"
                }
              }
            }
          },
          "429": {
            "description": "Too many reports from here",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RateLimitedReply"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Batch": {
        "properties": {
          "key": {
            "type": "string",
            "format": "uuid",
            "title": "Key"
          },
          "kind": {
            "type": "string",
            "enum": ["move", "receipt", "install", "open", "report"],
            "title": "Kind"
          },
          "volunteer_id": {
            "type": "integer",
            "maximum": 2147483647.0,
            "exclusiveMinimum": 0.0,
            "title": "Volunteer Id"
          },
          "from_location_id": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 2147483647.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "From Location Id"
          },
          "to_location_id": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 2147483647.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "To Location Id"
          },
          "install_number": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 2147483647.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Install Number"
          },
          "lines": {
            "items": {
              "$ref": "#/components/schemas/Line"
            },
            "type": "array",
            "maxItems": 500,
            "title": "Lines",
            "description": "One line per item and package (or loose): a batch naming one on more than one line is refused, 422 with type repeated on each of those lines. None only in a report."
          },
          "used_up": {
            "anyOf": [
              {
                "items": {
                  "type": "string",
                  "format": "uuid"
                },
                "type": "array",
                "maxItems": 500
              },
              {
                "type": "null"
              }
            ],
            "title": "Used Up",
            "description": "Keys of open packages the volunteer says are used up, for an administrator to confirm (docs/decisions/0020): with a cut that took all they showed, or alone, in a report."
          }
        },
        "type": "object",
        "required": ["key", "kind", "volunteer_id", "lines"],
        "title": "Batch"
      },
      "Catalogue": {
        "properties": {
          "settings": {
            "$ref": "#/components/schemas/Settings"
          },
          "volunteers": {
            "items": {
              "$ref": "#/components/schemas/VolunteerEntry"
            },
            "type": "array",
            "title": "Volunteers"
          },
          "locations": {
            "items": {
              "$ref": "#/components/schemas/LocationEntry"
            },
            "type": "array",
            "title": "Locations"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/ItemEntry"
            },
            "type": "array",
            "title": "Items"
          },
          "labels": {
            "items": {
              "$ref": "#/components/schemas/LabelEntry"
            },
            "type": "array",
            "title": "Labels"
          },
          "open_packages": {
            "items": {
              "$ref": "#/components/schemas/OpenPackageEntry"
            },
            "type": "array",
            "title": "Open Packages"
          },
          "saved": {
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "type": "array",
            "title": "Saved",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "settings",
          "volunteers",
          "locations",
          "items",
          "labels",
          "open_packages"
        ],
        "title": "Catalogue"
      },
      "CodeRefusedReply": {
        "properties": {
          "reason": {
            "type": "string",
            "enum": ["unknown", "expired", "used_up", "revoked"],
            "title": "Reason"
          }
        },
        "type": "object",
        "required": ["reason"],
        "title": "CodeRefusedReply"
      },
      "DeviceRefusedReply": {
        "properties": {
          "reason": {
            "type": "string",
            "enum": ["unregistered", "revoked"],
            "title": "Reason"
          }
        },
        "type": "object",
        "required": ["reason"],
        "title": "DeviceRefusedReply"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": ["status"],
        "title": "Health"
      },
      "ItemEntry": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "unit": {
            "type": "string",
            "title": "Unit"
          },
          "category": {
            "type": "string",
            "title": "Category"
          },
          "manufacturer": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Manufacturer"
          },
          "part_number": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Part Number"
          },
          "old_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Old Code"
          },
          "packages": {
            "items": {
              "$ref": "#/components/schemas/PackageEntry"
            },
            "type": "array",
            "title": "Packages"
          },
          "retired": {
            "type": "boolean",
            "title": "Retired"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "unit",
          "category",
          "manufacturer",
          "part_number",
          "old_code",
          "packages",
          "retired"
        ],
        "title": "ItemEntry"
      },
      "KeyReusedReply": {
        "properties": {
          "reason": {
            "type": "string",
            "const": "key_reused",
            "title": "Reason"
          }
        },
        "type": "object",
        "required": ["reason"],
        "title": "KeyReusedReply"
      },
      "LabelEntry": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "item_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Item Id"
          },
          "package_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Package Id"
          },
          "location_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Location Id"
          }
        },
        "type": "object",
        "required": ["code", "item_id", "package_id", "location_id"],
        "title": "LabelEntry",
        "description": "A printed code, and the one thing it names."
      },
      "Line": {
        "properties": {
          "item_id": {
            "type": "integer",
            "maximum": 2147483647.0,
            "exclusiveMinimum": 0.0,
            "title": "Item Id"
          },
          "quantity": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Quantity"
          },
          "package_id": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 2147483647.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Package Id",
            "description": "Sealed packages of this package of the item, kept sealed (docs/decisions/0020): `quantity` is a whole number of them, in units. None: loose units. An opening's lines name the package opened."
          },
          "open_package_key": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Open Package Key",
            "description": "An opening's: the key of the open package made, if its item tracks opened packages, made by the page so a later line can name it. One package a line, then. Any other line's: the open package it is taken from, cut loose, or moved whole."
          },
          "whole": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Whole",
            "description": "A move's line taken from an open package: all that is left on it, `quantity`, moves with it, and it stays open there."
          }
        },
        "type": "object",
        "required": ["item_id", "quantity"],
        "title": "Line"
      },
      "LocationEntry": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "kind": {
            "type": "string",
            "title": "Kind"
          },
          "parent_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parent Id"
          }
        },
        "type": "object",
        "required": ["id", "name", "kind", "parent_id"],
        "title": "LocationEntry"
      },
      "OpenPackageEntry": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "key": {
            "type": "string",
            "format": "uuid",
            "title": "Key"
          },
          "item_id": {
            "type": "integer",
            "title": "Item Id"
          },
          "package_id": {
            "type": "integer",
            "title": "Package Id"
          },
          "package_name": {
            "type": "string",
            "title": "Package Name"
          },
          "location_id": {
            "type": "integer",
            "title": "Location Id"
          },
          "opened_at": {
            "type": "string",
            "format": "date-time",
            "title": "Opened At"
          },
          "left": {
            "type": "string",
            "title": "Left"
          },
          "short_below": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Short Below"
          }
        },
        "type": "object",
        "required": [
          "id",
          "key",
          "item_id",
          "package_id",
          "package_name",
          "location_id",
          "opened_at",
          "left",
          "short_below"
        ],
        "title": "OpenPackageEntry",
        "description": "A package opened and followed, not reported used up: one a cart can\ntake from where it is."
      },
      "OutboxRetry": {
        "properties": {
          "kind": {
            "type": "string",
            "const": "outbox_retry",
            "title": "Kind"
          },
          "reason": {
            "type": "string",
            "enum": ["no_answer", "unavailable", "unexpected"],
            "title": "Reason"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["kind", "reason"],
        "title": "OutboxRetry"
      },
      "PackageEntry": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "size": {
            "type": "string",
            "title": "Size"
          },
          "track_opened": {
            "type": "boolean",
            "title": "Track Opened"
          },
          "retired": {
            "type": "boolean",
            "title": "Retired"
          },
          "short_below": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Short Below"
          },
          "sealed": {
            "items": {
              "$ref": "#/components/schemas/SealedAt"
            },
            "type": "array",
            "title": "Sealed"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "size",
          "track_opened",
          "retired",
          "short_below",
          "sealed"
        ],
        "title": "PackageEntry"
      },
      "PageError": {
        "properties": {
          "kind": {
            "type": "string",
            "const": "error",
            "title": "Kind"
          },
          "page": {
            "type": "string",
            "enum": ["scan", "register"],
            "title": "Page"
          },
          "source": {
            "type": "string",
            "enum": ["error", "unhandledrejection"],
            "title": "Source"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["kind", "page", "source"],
        "title": "PageError"
      },
      "RateLimitedReply": {
        "properties": {
          "reason": {
            "type": "string",
            "const": "rate_limited",
            "title": "Reason"
          }
        },
        "type": "object",
        "required": ["reason"],
        "title": "RateLimitedReply"
      },
      "Registered": {
        "properties": {
          "device_id": {
            "type": "integer",
            "title": "Device Id"
          }
        },
        "type": "object",
        "required": ["device_id"],
        "title": "Registered"
      },
      "Registration": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          }
        },
        "type": "object",
        "required": ["code"],
        "title": "Registration"
      },
      "Report": {
        "properties": {
          "events": {
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/WebVital"
                },
                {
                  "$ref": "#/components/schemas/PageError"
                },
                {
                  "$ref": "#/components/schemas/OutboxRetry"
                },
                {
                  "$ref": "#/components/schemas/ScanToSave"
                }
              ],
              "discriminator": {
                "propertyName": "kind",
                "mapping": {
                  "error": "#/components/schemas/PageError",
                  "outbox_retry": "#/components/schemas/OutboxRetry",
                  "scan_to_save": "#/components/schemas/ScanToSave",
                  "web_vital": "#/components/schemas/WebVital"
                }
              }
            },
            "type": "array",
            "maxItems": 50,
            "minItems": 1,
            "title": "Events"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["events"],
        "title": "Report"
      },
      "Saved": {
        "properties": {
          "transaction_id": {
            "type": "integer",
            "title": "Transaction Id"
          }
        },
        "type": "object",
        "required": ["transaction_id"],
        "title": "Saved"
      },
      "ScanToSave": {
        "properties": {
          "kind": {
            "type": "string",
            "const": "scan_to_save",
            "title": "Kind"
          },
          "seconds": {
            "type": "number",
            "maximum": 86400.0,
            "minimum": 0.0,
            "title": "Seconds"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["kind", "seconds"],
        "title": "ScanToSave"
      },
      "SealedAt": {
        "properties": {
          "location_id": {
            "type": "integer",
            "title": "Location Id"
          },
          "count": {
            "type": "integer",
            "title": "Count"
          }
        },
        "type": "object",
        "required": ["location_id", "count"],
        "title": "SealedAt"
      },
      "Settings": {
        "properties": {
          "name_check_minutes": {
            "type": "integer",
            "title": "Name Check Minutes"
          }
        },
        "type": "object",
        "required": ["name_check_minutes"],
        "title": "Settings",
        "description": "How the page behaves, as administrators set it (models.ScanSettings)."
      },
