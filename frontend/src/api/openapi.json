{
  "openapi": "3.1.0",
  "info": {
    "title": "NYC Mesh Inventory",
    "version": "0.1.0"
  },
  "paths": {
    "/api/healthz": {
      "get": {
        "summary": "Healthz",
        "description": "Answers once the database does. db.install() makes a failure a 503.",
        "operationId": "healthz_api_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "The database cannot answer; try again",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnavailableReply"
                }
              }
            }
          }
        }
      }
    },
    "/api/devices": {
      "post": {
        "summary": "Register Device",
        "description": "Register this browser with a code, and give it its cookie.",
        "operationId": "register_device_api_devices_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Registration"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Registered"
                }
              }
            }
          },
          "503": {
            "description": "The database cannot answer; try again",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnavailableReply"
                }
              }
            }
          },
          "400": {
            "description": "The code is not one that registers",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CodeRefusedReply"
                }
              }
            }
          },
          "429": {
            "description": "Too many attempts from here",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RateLimitedReply"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/transactions": {
      "post": {
        "summary": "Save Batch",
        "description": "Write a whole batch, or none of it. A 422 names each bad line.",
        "operationId": "save_batch_api_transactions_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Batch"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Saved"
                }
              }
            }
          },
          "503": {
            "description": "The database cannot answer; try again",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnavailableReply"
                }
              }
            }
          },
          "200": {
            "description": "Already written with this key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Saved"
                }
              }
            }
          },
          "403": {
            "description": "This device is not registered",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceRefusedReply"
                }
              }
            }
          },
          "409": {
            "description": "The key was used for another batch",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KeyReusedReply"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Batch": {
        "properties": {
          "key": {
            "type": "string",
            "format": "uuid",
            "title": "Key"
          },
          "kind": {
            "type": "string",
            "enum": ["move", "receipt", "install"],
            "title": "Kind"
          },
          "volunteer_id": {
            "type": "integer",
            "maximum": 2147483647.0,
            "exclusiveMinimum": 0.0,
            "title": "Volunteer Id"
          },
          "from_location_id": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 2147483647.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "From Location Id"
          },
          "to_location_id": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 2147483647.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "To Location Id"
          },
          "install_number": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 2147483647.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Install Number"
          },
          "lines": {
            "items": {
              "$ref": "#/components/schemas/Line"
            },
            "type": "array",
            "maxItems": 500,
            "minItems": 1,
            "title": "Lines"
          }
        },
        "type": "object",
        "required": ["key", "kind", "volunteer_id", "lines"],
        "title": "Batch"
      },
      "CodeRefusedReply": {
        "properties": {
          "reason": {
            "type": "string",
            "enum": ["unknown", "expired", "used_up", "revoked"],
            "title": "Reason"
          }
        },
        "type": "object",
        "required": ["reason"],
        "title": "CodeRefusedReply"
      },
      "DeviceRefusedReply": {
        "properties": {
          "reason": {
            "type": "string",
            "enum": ["unregistered", "revoked"],
            "title": "Reason"
          }
        },
        "type": "object",
        "required": ["reason"],
        "title": "DeviceRefusedReply"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": ["status"],
        "title": "Health"
      },
      "KeyReusedReply": {
        "properties": {
          "reason": {
            "type": "string",
            "const": "key_reused",
            "title": "Reason"
          }
        },
        "type": "object",
        "required": ["reason"],
        "title": "KeyReusedReply"
      },
      "Line": {
        "properties": {
          "item_id": {
            "type": "integer",
            "maximum": 2147483647.0,
            "exclusiveMinimum": 0.0,
            "title": "Item Id"
          },
          "quantity": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Quantity"
          }
        },
        "type": "object",
        "required": ["item_id", "quantity"],
        "title": "Line"
      },
      "RateLimitedReply": {
        "properties": {
          "reason": {
            "type": "string",
            "const": "rate_limited",
            "title": "Reason"
          }
        },
        "type": "object",
        "required": ["reason"],
        "title": "RateLimitedReply"
      },
      "Registered": {
        "properties": {
          "device_id": {
            "type": "integer",
            "title": "Device Id"
          }
        },
        "type": "object",
        "required": ["device_id"],
        "title": "Registered"
      },
      "Registration": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          }
        },
        "type": "object",
        "required": ["code"],
        "title": "Registration"
      },
      "Saved": {
        "properties": {
          "transaction_id": {
            "type": "integer",
            "title": "Transaction Id"
          }
        },
        "type": "object",
        "required": ["transaction_id"],
        "title": "Saved"
      },
      "UnavailableReply": {
        "properties": {
          "reason": {
            "type": "string",
            "const": "database_unavailable",
            "title": "Reason"
          }
        },
        "type": "object",
        "required": ["reason"],
        "title": "UnavailableReply"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": ["loc", "msg", "type"],
        "title": "ValidationError"
      }
    }
  }
}
