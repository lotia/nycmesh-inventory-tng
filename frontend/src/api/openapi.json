{
  "openapi": "3.1.0",
  "info": {
    "title": "NYC Mesh Inventory",
    "version": "0.1.0"
  },
  "paths": {
    "/api/healthz": {
      "get": {
        "summary": "Healthz",
        "description": "Answers once the database does. db.install() makes a failure a 503.",
        "operationId": "healthz_api_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "The database cannot answer; try again",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnavailableReply"
                }
              }
            }
          }
        }
      }
    },
    "/api/devices": {
      "post": {
        "summary": "Register Device",
        "description": "Register this browser with a code, and give it its cookie.",
        "operationId": "register_device_api_devices_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Registration"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Registered"
                }
              }
            }
          },
          "503": {
            "description": "The database cannot answer; try again",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnavailableReply"
                }
              }
            }
          },
          "400": {
            "description": "The code is not one that registers",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CodeRefusedReply"
                }
              }
            }
          },
          "429": {
            "description": "Too many attempts from here",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RateLimitedReply"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/transactions": {
      "post": {
        "summary": "Save Batch",
        "description": "Write a whole batch, or none of it. A 422 names each bad line.",
        "operationId": "save_batch_api_transactions_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Batch"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Saved"
                }
              }
            }
          },
          "503": {
            "description": "The database cannot answer; try again",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnavailableReply"
                }
              }
            }
          },
          "200": {
            "description": "Already written with this key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Saved"
                }
              }
            }
          },
          "403": {
            "description": "This device is not registered",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceRefusedReply"
                }
              }
            }
          },
          "409": {
            "description": "The key was used for another batch",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KeyReusedReply"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/catalogue": {
      "get": {
        "summary": "Get Catalogue",
        "description": "Everything current that a cart can hold, and who can fill one.",
        "operationId": "get_catalogue_api_catalogue_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Catalogue"
                }
              }
            }
          },
          "503": {
            "description": "The database cannot answer; try again",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnavailableReply"
                }
              }
            }
          },
          "403": {
            "description": "This device is not registered",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceRefusedReply"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Batch": {
        "properties": {
          "key": {
            "type": "string",
            "format": "uuid",
            "title": "Key"
          },
          "kind": {
            "type": "string",
            "enum": ["move", "receipt", "install"],
            "title": "Kind"
          },
          "volunteer_id": {
            "type": "integer",
            "maximum": 2147483647.0,
            "exclusiveMinimum": 0.0,
            "title": "Volunteer Id"
          },
          "from_location_id": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 2147483647.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "From Location Id"
          },
          "to_location_id": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 2147483647.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "To Location Id"
          },
          "install_number": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 2147483647.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Install Number"
          },
          "lines": {
            "items": {
              "$ref": "#/components/schemas/Line"
            },
            "type": "array",
            "maxItems": 500,
            "minItems": 1,
            "title": "Lines"
          }
        },
        "type": "object",
        "required": ["key", "kind", "volunteer_id", "lines"],
        "title": "Batch"
      },
      "Catalogue": {
        "properties": {
          "volunteers": {
            "items": {
              "$ref": "#/components/schemas/VolunteerEntry"
            },
            "type": "array",
            "title": "Volunteers"
          },
          "locations": {
            "items": {
              "$ref": "#/components/schemas/LocationEntry"
            },
            "type": "array",
            "title": "Locations"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/ItemEntry"
            },
            "type": "array",
            "title": "Items"
          },
          "labels": {
            "items": {
              "$ref": "#/components/schemas/LabelEntry"
            },
            "type": "array",
            "title": "Labels"
          }
        },
        "type": "object",
        "required": ["volunteers", "locations", "items", "labels"],
        "title": "Catalogue"
      },
      "CodeRefusedReply": {
        "properties": {
          "reason": {
            "type": "string",
            "enum": ["unknown", "expired", "used_up", "revoked"],
            "title": "Reason"
          }
        },
        "type": "object",
        "required": ["reason"],
        "title": "CodeRefusedReply"
      },
      "DeviceRefusedReply": {
        "properties": {
          "reason": {
            "type": "string",
            "enum": ["unregistered", "revoked"],
            "title": "Reason"
          }
        },
        "type": "object",
        "required": ["reason"],
        "title": "DeviceRefusedReply"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": ["status"],
        "title": "Health"
      },
      "ItemEntry": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "unit": {
            "type": "string",
            "title": "Unit"
          },
          "category": {
            "type": "string",
            "title": "Category"
          },
          "manufacturer": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Manufacturer"
          },
          "part_number": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Part Number"
          },
          "old_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Old Code"
          },
          "packages": {
            "items": {
              "$ref": "#/components/schemas/PackageEntry"
            },
            "type": "array",
            "title": "Packages"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "unit",
          "category",
          "manufacturer",
          "part_number",
          "old_code",
          "packages"
        ],
        "title": "ItemEntry"
      },
      "KeyReusedReply": {
        "properties": {
          "reason": {
            "type": "string",
            "const": "key_reused",
            "title": "Reason"
          }
        },
        "type": "object",
        "required": ["reason"],
        "title": "KeyReusedReply"
      },
      "LabelEntry": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "item_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Item Id"
          },
          "package_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Package Id"
          },
          "location_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Location Id"
          }
        },
        "type": "object",
        "required": ["code", "item_id", "package_id", "location_id"],
        "title": "LabelEntry",
        "description": "A printed code, and the one thing it names."
      },
      "Line": {
        "properties": {
          "item_id": {
            "type": "integer",
            "maximum": 2147483647.0,
            "exclusiveMinimum": 0.0,
            "title": "Item Id"
          },
          "quantity": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Quantity"
          }
        },
        "type": "object",
        "required": ["item_id", "quantity"],
        "title": "Line"
      },
      "LocationEntry": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "kind": {
            "type": "string",
            "title": "Kind"
          },
          "parent_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parent Id"
          }
        },
        "type": "object",
        "required": ["id", "name", "kind", "parent_id"],
        "title": "LocationEntry"
      },
      "PackageEntry": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "size": {
            "type": "string",
            "title": "Size"
          }
        },
        "type": "object",
        "required": ["id", "name", "size"],
        "title": "PackageEntry"
      },
      "RateLimitedReply": {
        "properties": {
          "reason": {
            "type": "string",
            "const": "rate_limited",
            "title": "Reason"
          }
        },
        "type": "object",
        "required": ["reason"],
        "title": "RateLimitedReply"
      },
      "Registered": {
        "properties": {
          "device_id": {
            "type": "integer",
            "title": "Device Id"
          }
        },
        "type": "object",
        "required": ["device_id"],
        "title": "Registered"
      },
      "Registration": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          }
        },
        "type": "object",
        "required": ["code"],
        "title": "Registration"
      },
      "Saved": {
        "properties": {
          "transaction_id": {
            "type": "integer",
            "title": "Transaction Id"
          }
        },
        "type": "object",
        "required": ["transaction_id"],
        "title": "Saved"
      },
      "UnavailableReply": {
        "properties": {
          "reason": {
            "type": "string",
            "const": "database_unavailable",
            "title": "Reason"
          }
        },
        "type": "object",
        "required": ["reason"],
        "title": "UnavailableReply"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": ["loc", "msg", "type"],
        "title": "ValidationError"
      },
      "VolunteerEntry": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          }
        },
        "type": "object",
        "required": ["id", "name"],
        "title": "VolunteerEntry"
      }
    }
  }
}
