# Rendered at container start by envsubst so that a SINGLE frontend image
# works in every environment -- nothing environment-specific is baked into
# the JavaScript bundle. See docs/deployment.md.

# Absent, or anything that is not a scheme, means there is no proxy in front of
# us worth believing, so fall back to our own. Only the two recognised values
# pass through: the header is whatever the client sent unless the ingress
# overwrote it, and Django decides cookie security and the CSRF origin check
# from it -- see docs/deployment.md for the condition that makes trusting it
# sound at all.
map $http_x_forwarded_proto $forwarded_proto {
    default $scheme;
    https   https;
    http    http;
}

# The host this container was reached on, forwarded to everything behind it.
#
# THE PORT IS THE WHOLE REASON THIS IS NOT `$host`. Django settles whether a
# write is safe by rebuilding the origin it expects from the host it was handed
# and comparing that against what the browser claims. `$host` is nginx's
# normalised name and it leaves the port off, so Django was comparing
# `http://localhost` against a browser saying `http://localhost:8080`, deciding
# they disagreed, and refusing every POST, PUT, PATCH and DELETE in the
# application with "CSRF Failed: Origin checking failed".
#
# That never showed in a deployment, which is why it survived being written:
# there a browser arrives on 443 and omits the port on both sides, so the two
# agree. Only a stack reached by some other port can see it, and every local
# one is.
#
# `$http_host` is the header verbatim, which is what fixes it. The fallback is
# for the case `$host` used to cover on its own: the header is not compulsory
# in HTTP/1.0, and forwarding an empty one would earn a DisallowedHost from
# Django where this used to answer. Nothing a browser does reaches that arm.
map $http_host $forwarded_host {
    ""      $host;
    default $http_host;
}

# What a span post is counted against.
#
# NOT `$binary_remote_addr`, which is what shipped and what made this limit
# mean something other than it says. This container sits behind an ingress and
# sees the client only through a header -- the same fact that puts the
# administrative narrowing at that boundary rather than here -- so every
# browser in the deployment arrived as one address and shared one bucket. Two
# volunteers handed debug links during the same incident, or a single batch
# flush of more than `burst`, and nginx answered 503 to the session actually
# being debugged.
#
# The token is what the allowance is about. It is one debugging session by
# construction, it is the same thing the backend counts its own
# DEBUG_TRACE_RATE against, and `auth_request` below refuses any that this
# deployment did not sign. A post arriving with no token has nowhere to go
# anyway, so those fall back to the address and are counted together.
map $http_x_debug_trace $span_bucket {
    ""      $binary_remote_addr;
    default $http_x_debug_trace;
}

# How much of the browser's own telemetry one session may post. A page reloaded
# in a loop, or a tab left open overnight, must not be able to fill whatever
# the collector writes to -- and the exporter batches, so a real session posts
# every few seconds rather than every span. Defined here because a zone is
# shared by every worker and cannot be declared inside a location.
limit_req_zone $span_bucket zone=spans:1m rate=2r/s;

server {
    listen       8080;
    server_name  _;
    root         /usr/share/nginx/html;

    # WITHOUT THIS, AN UPSTREAM THAT MOVES IS NEVER FOUND AGAIN. nginx resolves
    # the name in a `proxy_pass` once, when it loads its configuration, and
    # holds that address for the life of the worker. Restart the backend on its
    # own -- an ordinary thing to do while changing a setting -- and it comes
    # back on a different container address while this one goes on dialling the
    # old one, so every proxied path answers 502 for as long as the frontend is
    # left alone. The backend is up and answering directly the whole time,
    # which is what makes it read as the wrong container's fault.
    #
    # A `resolver`, plus an upstream held in a variable, is what makes nginx
    # ask again rather than remember. The nameservers come from the entrypoint
    # reading /etc/resolv.conf -- frontend/Dockerfile says why they cannot be
    # written down here.
    #
    # `valid` is deliberately short. This is a container address that changes
    # when a service restarts, so the cost of asking is a lookup on a local
    # resolver and the cost of not asking is the 502 above.
    #
    # IT IS A TRADE RATHER THAN A FREE WIN, and the direction is worth knowing
    # before anybody tunes it. Resolving once meant a running proxy could not
    # be hurt by DNS at all; resolving per request means it can. The problem
    # being solved is a local one -- in a cluster the backend is a Service with
    # a stable address, so re-resolving buys little there and costs a
    # dependency on the cluster's DNS that this container did not have.
    #
    # Kept anyway, for three reasons: `valid` absorbs any blip shorter than
    # itself, an address that really has changed is otherwise a permanent
    # outage rather than a slow one, and one behaviour everywhere is worth more
    # than an environment that is configured differently from the one people
    # develop against. Lengthen `valid` before reaching for anything else.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
    resolver_timeout 5s;

    # The upstreams, held in variables so that the `resolver` above is
    # consulted per request. `proxy_pass` given a variable no longer appends
    # the request's own URI, so every use of these below states it.
    set $backend ${BACKEND_ORIGIN};
    set $collector ${COLLECTOR_ORIGIN};

    gzip on;
    # application/wasm is the QR decoder, and it is roughly a megabyte
    # uncompressed on a page that has to work in a basement. See
    # docs/decisions/0011-qr-batch-scanning.md section 2 and
    # frontend/src/scan/decoder.ts, which is what makes it ours to serve.
    gzip_types text/css application/javascript application/json image/svg+xml application/wasm;
    gzip_min_length 1024;

    # The browser only ever talks to this origin; nginx forwards the API, the
    # admin, the sign-in pages and Django's own static files to Django. No
    # CORS in production, and no build-time API URL. `/accounts/` is where
    # every way in lives (docs/decisions/0013-administrator-sign-in.md), so a
    # deployment that does not forward it has no way to sign in at all.
    # `/static/` is Django's, not the app's: the bundle is served from
    # `/assets/` below, and without it those pages and the admin load with no
    # CSS or JavaScript.
    #
    # Two of these prefixes -- `/admin` and `/accounts` -- are also the ones a
    # deployment restricts to a network volunteers do not need, which happens
    # at the ingress and not here: this container is behind it and sees the
    # client only through a header. Which paths those are, and what the chart
    # does with them, is in docs/deployment.md#administrative-access. Forward
    # them regardless; narrowing the surface is that boundary's job, and
    # dropping one here would only break the local and compose setups, which
    # have no ingress at all.
    #
    # A regex rather than one prefix per path. `/api/` does not match `/api`
    # itself, and that is the endpoint index -- the first thing a client
    # fetches and the request that hands the browser its CSRF token -- so with
    # a trailing slash it fell through to the single-page app below and was
    # answered with index.html, in production only. `(/|$)` is what keeps the
    # fix from over-matching: `/api` and everything beneath `/api/` are
    # proxied, while a client-side route like `/apiary` still reaches the app.
    #
    # X-Forwarded-Proto is forwarded rather than set to $scheme: TLS is
    # terminated at the ingress, so $scheme here is always `http`, and telling
    # Django that has the consequences listed in docs/deployment.md -- which
    # also states the condition that makes trusting the header sound at all.
    # The `map` at the top falls back to $scheme when the header is absent, so
    # running this image without an ingress in front of it still works.
    #
    # Host comes from the `map` at the top of this file, which is where the
    # reason it is not `$scheme`'s neighbour `$host` is written down. Every
    # location below forwards the same one: a proxy that rewrites the host for
    # some of what is behind it and not the rest is a thing to reason about
    # twice, and there is nothing to be gained here for the cost of that.
    location ~ ^/(api|admin|accounts|static)(/|$) {
        proxy_pass         $backend$request_uri;
        proxy_set_header   Host              $forwarded_host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $forwarded_proto;
    }

    # Where the browser posts its spans, forwarded to the collector.
    #
    # SAME-ORIGIN BECAUSE THE POLICY SAYS SO. `connect-src 'self'` below is not
    # to be widened -- an exporter pointed straight at a collector would be
    # blocked by it, and admitting one origin admits it for everything else
    # this page could be made to fetch. So the browser posts here and nginx
    # forwards, which also keeps the collector off the internet entirely.
    #
    # AND IT IS NOT AN OPEN WRITE PATH. `auth_request` asks Django whether the
    # X-Debug-Trace header carries a token it signed and has not expired;
    # nothing is forwarded until that answers 204. nginx cannot check a
    # signature itself, which is why this is a subrequest rather than a rule.
    # See DebugTraceVerifyView and backend/src/inventory_tng/debugging.py.
    #
    # A batch from one page is kilobytes, so the body cap is small and the
    # rate is two a second. Both are the bound on what a leaked token can cost.
    location /v1/traces {
        auth_request       /api/debug-trace;
        limit_req          zone=spans burst=5 nodelay;
        client_max_body_size 64k;
        proxy_pass         $collector$request_uri;
        proxy_set_header   Host $forwarded_host;
    }

    # The subrequest above, and nothing else: it is not routable from outside,
    # so a client cannot use this deployment to test tokens against.
    location = /api/debug-trace {
        internal;
        proxy_pass         $backend/api/debug-trace;
        proxy_pass_request_body off;
        proxy_set_header   Content-Length "";
        proxy_set_header   Host $forwarded_host;
        proxy_set_header   X-Forwarded-Proto $forwarded_proto;
    }

    # Hashed asset filenames are safe to cache indefinitely.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Single-page app: unknown paths are client-side routes, not 404s.
    # Every other path is the app's, index.html included -- which is what makes
    # a label's own URL work. A sticker encodes /S/{code}, a phone's camera app
    # opens it directly, and there is no server-side route for it by design:
    # the code is read out of the path by the app itself. See
    # frontend/src/scan/deepLink.ts and docs/decisions/0011-qr-batch-scanning.md.
    # This rule is load-bearing, not incidental; a batch of labels already
    # stuck to shelves depends on it.
    #
    # The policy is on this location because it is the one that answers with a
    # *document*: a policy is enforced against the page that carries it, and
    # the page the volunteer app runs in is index.html, which is served from
    # here and never reaches Django. Django sets the same policy on what it
    # serves (CONTENT_SECURITY_POLICY in backend/src/inventory_tng/settings.py,
    # which is where the argument for each directive is written down). The two
    # have to agree and neither server can read the other's configuration, so a
    # change to one is a change to both.
    #
    # `always` so it is set on the 404 and 5xx bodies too, and not only on 200s.
    location / {
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
        try_files $uri $uri/ /index.html;
    }
}
