{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    // `scripts/theme-css.ts` is run by node directly, and node's type
    // stripping resolves an import exactly as written -- so it needs the `.ts`
    // on `../src/theme.ts`. Nothing is emitted from this project anyway (vite
    // builds the app), so allowing the extension costs nothing and the
    // alternative is a second tsconfig for one file.
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "types": ["vite/client", "node"]
  },
  "include": [
    "src",
    "integration",
    "capture",
    "scripts",
    "vite.config.ts",
    "playwright.config.ts",
    "playwright.capture.config.ts"
  ]
}
