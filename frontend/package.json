{
  "name": "inventory-tng-frontend",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "fix": "biome check --write .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "api": "npm ci --prefix tools/openapi --no-audit --no-fund && npm run --prefix tools/openapi generate && biome format --write src/api"
  },
  "dependencies": {
    "@preact/signals": "2.11.4",
    "barcode-detector": "3.2.3",
    "openapi-fetch": "0.17.0",
    "preact": "11.1.1",
    "uuid": "14.0.3",
    "valibot": "1.5.0",
    "web-vitals": "6.2.3",
    "zxing-wasm": "3.1.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@playwright/test": "1.64.1",
    "@preact/preset-vite": "2.10.6",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/preact": "3.2.6",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.0.5",
    "happy-dom": "21.0.4",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
