{
  "permissions": {
    "allow": [
      "Bash(scripts/landing-gate.sh:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/landing-gate.sh check",
            "timeout": 30,
            "statusMessage": "Checking the landing gate"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/landing-gate.sh stop",
            "timeout": 30,
            "statusMessage": "Checking the batch has been through its cycle"
          }
        ]
      }
    ]
  }
}
