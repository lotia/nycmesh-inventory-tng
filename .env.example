# Copy to .env, which git ignores: cp .env.example .env
# Who reads it, and what wins: CONTRIBUTING.md, Local settings.

# development: logs and traces keep personal data, for debugging; secrets stay
# masked (CONTRIBUTING.md, Logging). Unset means production, which redacts.
APP_ENV=development
# Show secrets as well. Only with APP_ENV=development; refused anywhere else.
# UNMASK_SECRETS=false

# The port compose publishes PostgreSQL on. 5433 sits beside MeshDB's 5432.
INVENTORY_DB_PORT=5433
DATABASE_URL=postgresql://inventory:inventory@localhost:${INVENTORY_DB_PORT}/inventory

# Logging (CONTRIBUTING.md, Logging). Uncommented, these are the defaults.
# LOG_LEVEL=INFO
# Single loggers' levels; for example sqlalchemy.engine=INFO shows SQL.
# LOG_LEVELS=
# LOG_FORMAT=console
# LOG_CLIENT_ADDRESS=true
# LOG_HEALTH_CHECKS=true

# Telemetry, off unless an endpoint is set. For the local dashboard:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# The scan page (CONTRIBUTING.md, The scan page). Load its scripts from Vite's
# dev server, for edits to show at once. Only with APP_ENV=development, and
# only for the server you run yourself: the app container always serves the
# bundle it built. The port is required. Each server logs which it uses, in
# its "frontend" line (source=dev_server or source=build).
# VITE_DEV_SERVER=http://localhost:5173

# Lets /setup make the first administrator (CONTRIBUTING.md, Running the
# app). At least 32 characters.
# SETUP_TOKEN=
# Lets /recover make a reset link for a locked-out administrator
# (DEPLOYMENT.md). At least 32 characters.
# RECOVERY_TOKEN=

# Mail, caught by Mailpit (CONTRIBUTING.md, Mail). Unset sends none.
# MAIL_HOST=localhost
# MAIL_PORT=1025
# MAIL_SECURITY=none
# MAIL_FROM=inventory@localhost
# SITE_URL=http://127.0.0.1:8000

# The app container (CONTRIBUTING.md, Running the app in a container).
# INVENTORY_APP_PORT=8000
# INVENTORY_APP_OTLP_ENDPOINT=http://dashboard:18890
# INVENTORY_APP_MAIL_HOST=mail
