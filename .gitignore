# Local environment configuration (copy .env.sample to .env)
.env

# Python
__pycache__/
*.py[cod]
.venv/
staticfiles/

# Node
node_modules/
dist/

# Coverage output
coverage/
.coverage
htmlcov/

# Playwright: traces and failure screenshots. Browser binaries live outside
# the repository, in the shared Playwright cache.
test-results/
playwright-report/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# Local scratch space: source material for the migration (exports of the
# existing Google Sheet, reference screenshots) that is not ours to publish.
ignored/

# The same material wherever it lands. A sheet export carries volunteer names
# and email addresses, so the directory rule above is not enough on its own:
# anyone told to "supply your own copy" will put it somewhere else eventually,
# and one `git add -A` would publish it.
*.xlsx
*.ods
*.csv

# Claude Code local-only configuration (personal; must not burn other
# contributors' tokens). See .claude/settings.local.json.
.claude/settings.local.json
.claude/hooks/
# Whatever the local gate is calling its receipt. It was .landing-receipt.json
# until the gate moved onto the merge and started keying them by pull request,
# and a name that changes is a name to match rather than to list.
.claude/*receipt*
.claude/**/*receipt*

# Agent worktrees: separate checkouts, never part of a commit.
.claude/worktrees/
