# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
*.gate.lock*

# Issues live in Dolt (.beads/dolt) and sync with `bd sync`; see CONTRIBUTING.md
.beads/issues.jsonl

# Personal VS Code workspaces; shared settings go in .vscode/settings.json
*.code-workspace

# Development's own secrets, such as the TOTP key mise run setup makes
.local/

# Python
__pycache__/
.venv/
.pytest_cache/
.ruff_cache/
*.pyc

# Coverage, written by mise run check
.coverage
.coverage.*
coverage.xml
frontend/coverage/

# The browser tests' output, written by mise run check-browser
frontend/test-results/
frontend/playwright-report/

# Checkouts Claude Code makes for agents working apart
.claude/worktrees/

# Local settings
.env

# bv (b9s) local config and caches
.bv/
