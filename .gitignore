# Local environment configuration (copy .env.sample to .env)
.env

# Python
__pycache__/
*.py[cod]
.venv/
staticfiles/

# Node
node_modules/
dist/

# Coverage output
coverage/
.coverage
htmlcov/

# Playwright: traces and failure screenshots. Browser binaries live outside
# the repository, in the shared Playwright cache.
test-results/
playwright-report/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# Local scratch space: source material for the migration (exports of the
# existing Google Sheet, reference screenshots) that is not ours to publish.
ignored/

# Claude Code local-only configuration (personal; must not burn other
# contributors' tokens). See .claude/settings.local.json.
.claude/settings.local.json
.claude/hooks/
.claude/.landing-receipt.json
