# Kept out of the build context, which is the repository's root. Docker and
# Podman both read this file. Local settings, version control and issues
# never belong in an image.
.env
.local/
.git/
.jj/
.beads/
.claude/
.codex/
.cursor/
**/.venv/
**/__pycache__/
**/.pytest_cache/
**/.ruff_cache/
frontend/node_modules/
frontend/dist/
# Not needed to build the bundle, so editing them does not rebuild it.
frontend/**/*.test.ts
frontend/**/*.test.tsx
frontend/biome.json
frontend/src/test-*.ts
frontend/src/**/*.typecheck.ts
# The generator runs on a contributor's machine; its output is committed.
frontend/tools/
