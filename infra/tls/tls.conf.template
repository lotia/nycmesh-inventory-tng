# TLS in front of the frontend container, for local development only.
#
# This proxy adds a hop: browser -> here -> frontend nginx -> Django. That is
# why NUM_PROXIES is 2 when this profile is up and 1 when it is not; compose.yaml
# says what to set and .env.sample says which direction is dangerous.

# The upstream is held in a variable and re-resolved, for the same reason
# frontend/nginx.conf.template does it: a container that restarts comes back on
# a different address, and an nginx that resolved once would dial the old one
# until somebody restarted this container too.
resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
resolver_timeout 5s;

server {
    listen 8443 ssl;
    http2 on;
    server_name _;

    ssl_certificate     /certificate/tls.crt;
    ssl_certificate_key /certificate/tls.key;

    # TLS 1.2 and 1.3 only. Not a hardening exercise -- nothing here faces the
    # internet -- but the version an iPhone negotiates is part of what is being
    # measured by inventory-tng-dzwu.3, and a stack that quietly fell back to
    # something ancient would make that answer meaningless.
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:tls:1m;
    ssl_session_timeout 10m;

    set $upstream ${UPSTREAM_ORIGIN};

    # Everything, unchanged, to the frontend container -- which already knows
    # which paths are Django's. This proxy makes no routing decisions of its
    # own: two files deciding that is two files to keep in step.
    location / {
        proxy_pass $upstream$request_uri;

        # THE HEADER THE WHOLE THING TURNS ON. Django rebuilds the origin it
        # expects from this, and the frontend's nginx passes whatever it is
        # given straight through. Without it Django computes http://... while
        # the browser claims https://..., decides they disagree, and refuses
        # every write in the application with "CSRF Failed: Origin checking
        # failed" -- on a stack whose address bar says https, which is a
        # confusing way to spend an afternoon.
        proxy_set_header X-Forwarded-Proto https;

        # $http_host rather than $host, so the :8443 survives. The frontend's
        # own template carries the full argument for why the port matters and
        # it is not repeated here.
        proxy_set_header Host              $http_host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;

        # The camera decodes in a WebAssembly module of about a megabyte, and
        # the scanner posts batches. Neither is large, but a default that
        # buffered them for no reason would show up as latency on a phone in a
        # basement, which is the one place this is meant to work.
        proxy_buffering off;
        client_max_body_size 8m;
    }
}
