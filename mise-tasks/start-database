#!/usr/bin/env bash
#MISE description="Start the database server every checkout shares, unless its container's settings differ from this checkout's compose.yaml"
# CONTRIBUTING.md, Local settings. Every task that needs the server starts it
# here, never recreating its container: that would end every checkout's
# connections. When compose.yaml has changed what the container runs with,
# this stops and says how to recreate it.
set -euo pipefail

here=$(dirname "$0")
root=${MISE_PROJECT_ROOT:-$here/..}
compose() { "$here/compose" "$@"; }

# Compose labels a container with a hash of its service's settings, the
# label `config --hash` compares with. The settings include the path of the
# checkout that made it, which a bind mount names: so this checkout's
# compose.yaml and .env are hashed as if from that one.
made=$(compose ps --all --format \
  '{{.Label "com.docker.compose.config-hash"}}|{{.Label "com.docker.compose.project.working_dir"}}' db)
if [[ -n $made ]]; then
  IFS='|' read -r running made_in <<<"$made"
  env_file=$root/.env
  [[ -f $env_file ]] || env_file=/dev/null
  wanted=$(compose --file "$root/compose.yaml" --project-directory "${made_in:-$root}" \
    --env-file "$env_file" config --hash db)
  if [[ ${wanted#db } != "$running" ]]; then
    echo "The database container's settings differ from this checkout's compose.yaml." \
      "Run \`mise run recreate-database-container\`, which restarts it for every checkout's connections." >&2
    exit 1
  fi
fi
compose up -d --wait --no-recreate db
