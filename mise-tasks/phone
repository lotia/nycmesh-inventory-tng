#!/usr/bin/env bash
#MISE description="Serve the app over https through a tunnel, and show a QR code that registers a phone"
#MISE depends=["dev-database"]
# CONTRIBUTING.md, On a phone.
set -euo pipefail

# The compose task's script itself: no mise for each call, and timeout
# can run it.
compose=$(dirname "$0")/compose
compose() { "$compose" "$@"; }
clone=$(dirname "$0")/..
devtools() {
  PYTHONPATH="$clone/backend" \
    uv run --quiet --frozen --project "$clone/backend" python -m devtools "$@"
}

# Another port, saying which, when INVENTORY_APP_PORT's is taken, as by
# mise run dev's backend; the tunnel reaches the app inside its container.
INVENTORY_APP_PORT=$(devtools stack free-port INVENTORY_APP_PORT)
export INVENTORY_APP_PORT

# dev-database first (depends): the server's container makes only
# `inventory`, not this checkout's database.
compose up -d --build --wait app
echo "The app here: http://127.0.0.1:$INVENTORY_APP_PORT"
# A new container, so its log holds only this tunnel's address; --no-deps
# leaves the app as it is.
compose --profile phone up -d --force-recreate --no-deps tunnel
url=$(timeout 60 "$compose" logs -f tunnel 2>&1 |
  grep -v '//api\.' |
  grep -m 1 -o 'https://[a-z0-9-]*\.trycloudflare\.com' || true)
if [[ -z $url ]]; then
  echo "No tunnel address: mise run compose -- logs tunnel" >&2
  exit 1
fi
compose exec -T app python -m inventory_tng.manage registration-codes create \
  --uses 1 --days 1 --label phone --base-url "$url"
echo "Stop it with: mise run compose -- --profile phone stop tunnel"
