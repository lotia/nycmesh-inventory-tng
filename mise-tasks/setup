#!/usr/bin/env bash
#MISE description="Set up a clone: every tool, the dependencies, and a .env to start from; -- --new-ports gives an existing .env free ports"
# CONTRIBUTING.md, Requirements. Safe to run again, as after a pull.
set -euo pipefail
cd "${MISE_PROJECT_ROOT:-$(dirname "$0")/..}"

new_ports=false
for argument in "$@"; do
  case $argument in
    --new-ports) new_ports=true ;;
    *)
      echo "Unknown argument $argument: only --new-ports" >&2
      exit 2
      ;;
  esac
done

# mise installs the tools in mise.toml before it runs this.
(cd backend && uv sync)
# npm ci starts node_modules again: only when the lockfile is newer.
if [[ frontend/package-lock.json -nt frontend/node_modules/.package-lock.json ]]; then
  (cd frontend && npm ci)
fi
if [[ ! -f .env ]]; then
  # A compose stack of this checkout's own, with its database, and ports no
  # other stack of this repository claims and nothing listens on
  # (CONTRIBUTING.md, Local settings).
  (cd backend && uv run --quiet --frozen python -m inventory_tng.stacks new-env) >.env.new
  mv .env.new .env
  echo "Made .env from .env.example, with a compose stack and database of its own:" \
    "$(grep '^COMPOSE_PROJECT_NAME=' .env)"
elif $new_ports; then
  # Only its port settings, each free or this checkout's stack's
  # (CONTRIBUTING.md, Local settings); every other line stays.
  (cd backend && uv run --quiet --frozen python -m inventory_tng.stacks new-ports)
fi
# The key development seals authenticators' TOTP keys with (DEPLOYMENT.md,
# TOTP keys), readable by you alone. Made again if empty, as a run that
# failed while making it leaves it.
if [[ ! -s .local/totp-keys/1 ]]; then
  mkdir -p .local/totp-keys
  (umask 077 && cd backend &&
    uv run python -m inventory_tng.totp_keys new > ../.local/totp-keys/1)
  echo "Made a TOTP key in .local/totp-keys."
fi
# The one thing mise cannot install: this says if it is missing.
"$(dirname "$0")/compose" version >/dev/null
