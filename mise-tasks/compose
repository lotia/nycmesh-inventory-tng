#!/usr/bin/env bash
#MISE description="Run compose with your container runtime: mise run compose -- <arguments>"
#MISE quiet=true
#MISE raw=true
# The runtime is INVENTORY_COMPOSE, from the environment or .env, else
# Podman if it is installed, else Docker (CONTRIBUTING.md, Requirements).
set -euo pipefail

# The clone this script is in, for the backend's code; .env is in the
# project mise is running for, which is the same one unless a test says not.
clone=$(dirname "$0")/..
root=${MISE_PROJECT_ROOT:-$clone}
compose=${INVENTORY_COMPOSE:-}
if [[ -z $compose && -f $root/.env ]]; then
  # Read as the backend reads .env, quotes, comments and all.
  compose=$(uv run --quiet --frozen --project "$clone/backend" python -c \
    'import sys; from inventory_tng.local_env import local_env_values
print(local_env_values(sys.argv[1]).get("INVENTORY_COMPOSE", ""))' "$root/.env")
fi
if [[ -z $compose ]]; then
  if command -v podman >/dev/null; then
    compose="podman compose"
  elif command -v docker >/dev/null; then
    compose="docker compose"
  else
    echo "No Podman or Docker: install one, or set INVENTORY_COMPOSE in .env" >&2
    exit 1
  fi
fi
# A command and its first arguments, such as "docker compose": split on
# purpose.
# shellcheck disable=SC2086
exec $compose "$@"
