#!/usr/bin/env bash
#MISE description="Run the app for development: the database, the backend with reload, and Vite's dev server"
#MISE depends=["setup"]
# CONTRIBUTING.md, Running the app. Ctrl-C stops both servers.
set -euo pipefail

clone=$(dirname "$0")/..

# Vite's address, read as the backend reads it (the shell, then .env), else
# the same default as DEFAULT_ORIGIN in frontend/vite.config.ts. Both servers
# get it from here, so they agree.
VITE_DEV_SERVER=$(uv run --quiet --frozen --project "$clone/backend" \
  python -m inventory_tng.local_env VITE_DEV_SERVER)
export VITE_DEV_SERVER=${VITE_DEV_SERVER:-http://localhost:5173}
# Output goes through mise, not a terminal: Vite keeps its colour with this.
export FORCE_COLOR=1

mise run dev-database

# Both at once, each line marked with its task. If either fails, mise stops
# the other; Ctrl-C stops both.
echo "The app: http://127.0.0.1:8000, its scripts from $VITE_DEV_SERVER"
exec mise run --jobs 2 --output prefix dev-backend ::: dev-vite
