# Local development environment.
#
# Copy to .env and adjust:  cp .env.sample .env
#
# Clearing a value is the same as deleting the line: a variable set to nothing
# gets the default, so emptying one here cannot leave the backend refusing to
# start. The two exceptions are DJANGO_SECRET_KEY and DATABASE_URL, which have
# no default on purpose and stop the process whether empty or absent -- an
# application with no signing key or no database has nothing useful to do.
#
# A comma-separated value may be written with spaces after the commas. They are
# not part of any entry, here or in a chart's values file, and a trailing comma
# adds nothing.
# Consumed by docker compose, the Django settings module, and the Vite dev
# server's configuration.
# Kubernetes supplies these same variables from ConfigMaps and Secrets --
# see docs/deployment.md for the production values of each.

# --- Django ---------------------------------------------------------------
# No default: a missing secret must fail loudly rather than start insecurely.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=dev-only-not-for-deployment-change-me

# Never true outside local development.
DJANGO_DEBUG=true

# How much the backend says. Everything at this level and above is written to
# standard output, in every environment -- there is no second arrangement for
# deployment, so what you read here is what a cluster collects.
# Any level Python knows: DEBUG, INFO, WARNING, ERROR, CRITICAL. A value it
# does not know stops the process rather than quietly becoming this default.
# DEBUG is loud enough to be worth turning on deliberately and off again.
DJANGO_LOG_LEVEL=INFO

# Turn one subsystem up without turning everything up. Comma-separated
# `logger=LEVEL` pairs, laid over the level above, so
# `inventory.sheet=DEBUG,django.db.backends=DEBUG` prints every query the
# importer makes and leaves the rest of the application at INFO. Without it,
# DEBUG means every query from everything, which is not a readable log.
#
# The SQL half of that example only works with DJANGO_DEBUG on: Django decides
# whether to record a query from that setting and not from the logger's level,
# so `django.db.backends=DEBUG` is silent in any deployment. Development only.
DJANGO_LOG_LEVELS=

# How a record is drawn: `console` for a person, `json` for a collector. The
# record is the same either way -- only the drawing differs -- so what you
# debug against is what a deployment emits.
#
# COMMENTED OUT ON PURPOSE, and this is the one line here where that matters.
# docker compose reads this file for ${...} substitution, so a value set here
# is not a default it can fall back from -- setting `console` would reach the
# compose backend and quietly turn off the JSON that stack exists to
# demonstrate. Left unset, native development gets `console` from the code and
# compose gets `json` from its own line. Uncomment to overrule both at once.
#DJANGO_LOG_FORMAT=console

# Which set of columns, when drawing for a terminal. Empty measures the
# terminal and says which it chose: `full` at 140 columns or more, `compact`
# below that, `minimal` below 100. Name one to override the measurement --
# `full`, `compact` or `minimal` -- which is also how to keep the whole
# timestamp on a narrow terminal, or give up the seventeen columns it costs on
# a wide one.
DJANGO_LOG_LAYOUT=

# Keys bound for the life of a request or a process -- request_id, trace_id,
# method, status -- are on every line, so the console leaves them out. Set to
# `shown` for the one occasion you want them: following a single request
# through a stream rather than reading it as a story.
DJANGO_LOG_CONTEXT=hidden

# How much a refused request may write, as `<count>/<period>` -- the same shape
# as the append rates below, with the period one of s, min, hour or day. Django
# writes a record per request it refuses, on a path that is internet-facing and
# takes no credential; docs/deployment.md#reading-the-logs is what this bounds
# and what it does with the ones it holds back.
#
# Counted per process, so what a deployment writes is this times the number of
# gunicorn workers. backend/src/inventory_tng/refusals.py says why it is not
# shared.
#
# Counted per logger under `django.security`, not across the family: a host
# scanner flooding one must not spend the window belonging to the CSRF and
# session failures, which mean somebody's session is broken.
#
# Nought is refused rather than read as "write none". Raise it instead when a
# deployment is genuinely refusing requests it should be answering and every
# line matters.
# The traceback is dropped from these records whatever this is set to --
# backend/src/inventory_tng/refusals.py says why it carries nothing.
DJANGO_SECURITY_LOG_RATE=10/min

# --- Telemetry ------------------------------------------------------------
# Traces and metrics, over OTLP. Logs do not come through here: they go to
# standard output and are collected from there. docs/decisions/0021 says why.
#
# Empty, and that is the point -- no endpoint means the SDK is not started at
# all, so a checkout with no collector behaves exactly as it did before any of
# this existed.
#
# This repository ships one for development, behind a compose profile, and
# docs/observability.md is the command that starts it and what to open. Under
# compose the address is http://collector:4318; for a backend running natively
# beside it, http://localhost:4318.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Whether telemetry may carry personal data. `redacted` -- the default, and
# what every configuration this repository ships sets -- means a span
# attribute, a metric attribute or a log key that this application has not
# declared never reaches an exporter. That includes the caller's IP address,
# which Django's instrumentation puts on every server span and which is
# personal data.
#
# `recorded` re-admits one enumerated group and nothing else, listed in
# docs/observability.md along with what admitting it obliges of wherever the
# telemetry lands. Read that before setting it: the obligation outlives the
# afternoon you set it for.
#
# It is deliberately awkward to leave on. The process announces it at startup
# and marks everything it writes while it is on, so what was recorded can be
# found again and deleted. A value that is neither word stops the process.
#
# backend/src/inventory_tng/redaction.py lists everything either way and says
# why each is where it is.
TELEMETRY_PERSONAL_DATA=redacted

# Recording one volunteer's requests in full, when they are the one meeting
# the failure. An administrator mints a token -- `manage.py mint_debug_token`
# -- and hands it over. docs/observability.md is what it authorises, what it
# deliberately does not, and why it is a token rather than a flag.
#
# How long a freshly minted one lasts, in seconds. Nought is refused: it would
# mint tokens expired before they were printed.
DEBUG_TRACE_LIFETIME_SECONDS=3600

# What one token may cost, in the shape of the rates above and counted per
# process. It bounds a leaked link rather than a volunteer. Nought is refused.
DEBUG_TRACE_RATE=60/min

# What this service is called wherever the telemetry lands, and anything else
# worth attaching to every span it produces. Standard OpenTelemetry names, so
# what you already know about them applies.
# Commented out for the reason DJANGO_LOG_FORMAT is: docker compose reads this
# file for ${...} substitution, so a value here is not a default it can fall
# back from, and setting it would label every compose span as development.
#OTEL_SERVICE_NAME=inventory-tng-backend
#OTEL_RESOURCE_ATTRIBUTES=deployment.environment=development

# The fraction of traces recorded, between 0 and 1, and which sampler decides.
# What the default is, what the shipped configurations set, and what a caller
# can and cannot ask for are all in docs/deployment.md#telemetry.
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0

# The Vite dev server passes the browser's Host through to Django rather than
# rewriting it, so whatever you type in the address bar has to be listed here.
# Serving the dev server on a LAN address to test scanning on a phone
# (`npm run dev -- --host`) therefore needs that address adding.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Names the deployment itself supplies, added to the list above rather than
# replacing it. Empty here and empty under compose: it is for an address that
# does not exist until the process is running, which in Kubernetes is the pod's
# own and is what a probe asks for. The chart fills it; nothing here needs to.
# docs/deployment.md#health-checks.
DJANGO_EXTRA_ALLOWED_HOSTS=

# Origins Django will accept a WRITE from. Django checks the origin a browser
# claims against the one it computed for itself, and this is the list it
# consults when those disagree.
#
# There is no reading equivalent, deliberately. Cross-origin reads are not
# supported here at all; `settings.py` says what that rests on and what
# supporting them would take.
#
# Empty here and empty in every configuration this repository ships, because
# nothing it ships needs it: one origin sits in front of everything, so the
# comparison agrees with itself. Fill it in when something between the browser
# and Django rewrites the host -- an ingress, a tunnel, a name the pod does not
# know itself by. The symptom that sends you here is every write refused with
# "CSRF Failed: Origin checking failed".
#
# Each entry carries a scheme, and a port when it is not the scheme's default:
#   CSRF_TRUSTED_ORIGINS=https://inventory.nycmesh.net,http://localhost:8080
CSRF_TRUSTED_ORIGINS=

# --- Rate limits ----------------------------------------------------------
# The two endpoints volunteers write to take no credential, so a rate is what
# stands in for one -- see docs/decisions/0012-two-populations.md. Both are DRF
# rate strings, "<requests>/<s|min|hour|day>", counted per signed-in account
# or, for anyone not signed in, per client address. Reads are never counted.
#
# The defaults are sized for a room rather than a person: volunteers at a hub
# share one address, and one submission already carries up to 500 lines, so
# appending is rare and expensive rather than frequent and cheap. Twenty a
# minute is a submission every three seconds -- more than a room of people can
# produce and less than a loop. The hourly limit is what catches a script slow
# enough to stay under that, and leaves an evening's packing session alone.
APPEND_BURST_RATE=20/min
APPEND_SUSTAINED_RATE=300/hour

# How many proxies sit between a browser and Django. The client address is read
# from the right of X-Forwarded-For, counting back this many hops, which is what
# makes the header usable: a client can prepend anything, but the proxies it
# passed through append after it. Too low puts everyone behind the last proxy in
# one bucket; too high reaches into the part a client controls, which is the
# dangerous direction. Locally there are no proxies and the header is absent, so
# this is unused.
#
# What it cannot do is tell a real hop from an invented one, because a caller
# writes entries as freely as a proxy appends them. That is tolerable for a rate
# limit -- believing a forger costs one bucket -- and not for anything deciding
# who gets in. TRUSTED_PROXIES below is that second reading, and this one is
# deliberately left alone; docs/decisions/0023-which-addresses-may-speak-for-another.md
# is the trade.
NUM_PROXIES=2

# The addresses whose word is taken about who a request came from -- this
# deployment's proxies and nothing besides. Comma-separated, each an address or
# a CIDR block. List EVERY hop, ingress and nginx alike; docs/deployment.md
# says what the walk does with them and where to read a cluster's range off.
#
# Which way it is dangerous to get wrong. Too NARROW, or empty as it is here, is
# safe and lossy: no header is believed, so every caller behind a proxy looks
# like the proxy. Too WIDE is the dangerous one, and there is no partial credit
# -- an address on this list may claim to be speaking for anybody, so a range
# covering the pod network, or 0.0.0.0/0, hands the header back to whoever
# writes it. Nothing here can detect that; it is what trusting an address means.
#
# Empty locally, where there is no proxy and no header, and empty in the chart's
# shipped values. Nothing in this application reads it yet -- every endpoint
# still asks for a session -- and it must be set before anything admits a caller
# by address.
TRUSTED_PROXIES=

# What a browser may report about itself. A budget of its own rather than a
# share of the two above, because the app posts here without anybody asking it
# to -- once per failing call -- and a backend having a bad minute would
# otherwise spend a volunteer's whole append allowance on reports about it.
# inventory/throttling.py argues it.
CLIENT_REPORT_RATE=30/min

# How often a device may ask to be told apart from the others.
#
# `POST /api/devices` answers everybody, because a device has nothing to
# present before it has enrolled -- so this number is the guard, and the
# signature on what it hands back is not. Sized for a room of people opening
# the app at once and not for a loop: a browser mints once and keeps what it is
# given, so a client reaching this limit is one that has lost what it stored,
# or one asking on purpose.
#
# A bucket of its own for the reason CLIENT_REPORT_RATE has one. Sharing the
# append allowance would let a burst of enrolments spend what a volunteer's
# batch needs, at exactly the moment a room is starting work.
#
# What a device credential is for -- attribution rather than admission -- and
# what it deliberately does not buy is in backend/src/inventory_tng/devices.py.
DEVICE_ENROLMENT_RATE=10/hour

# --- Signing in again -----------------------------------------------------
# How long a sign-in stays recent enough to make an administrative change --
# editing the catalogue, merging volunteers, revoking labels, minting codes --
# before the password or second factor is asked for again inside a valid
# session. Why that second prompt exists at all is
# docs/decisions/0014-one-interface.md point 5; how the number was chosen is
# on REAUTHENTICATION_TIMEOUT_SECONDS in backend/src/inventory_tng/settings.py.
# Fifteen minutes. allauth's own default is 300 seconds.
REAUTHENTICATION_TIMEOUT_SECONDS=900

# --- Sign-in providers ----------------------------------------------------
# Administrators sign in; volunteers do not (docs/decisions/0012-two-populations.md).
# Which ways in a deployment offers is settled in
# docs/decisions/0013-administrator-sign-in.md, and every one of them is
# optional: a provider whose client id or secret is missing is not offered, and
# a checkout with none of these set -- the ordinary case, including every test
# run -- offers the local username-and-password path with TOTP, which is never
# configured away.
#
# None of these grants anybody anything: what an account arriving from a
# provider may do is docs/decisions/0013-administrator-sign-in.md point 5, and
# docs/deployment.md says it again to whoever is standing a deployment up.
#
# The redirect URI to register with each provider is this deployment's origin
# followed by the path in the comment.

# Google. Console: https://console.cloud.google.com/apis/credentials
# Redirect URI: /accounts/google/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Slack. App settings: https://api.slack.com/apps -> OAuth & Permissions.
# Redirect URI: /accounts/slack/login/callback/
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Any OpenID Connect provider. OIDC_SERVER_URL is the issuer, the URL whose
# /.well-known/openid-configuration describes the rest. OIDC_NAME is what the
# button says; OIDC_PROVIDER_ID appears in the callback URL and so must match
# what you registered, which is why it is named rather than derived.
# Redirect URI: /accounts/oidc/${OIDC_PROVIDER_ID}/login/callback/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SERVER_URL=
OIDC_NAME=Single sign-on
OIDC_PROVIDER_ID=oidc

# --- Printed labels -------------------------------------------------------
# Where a scanned label sends the phone. This string is printed inside every
# QR code and stuck to a shelf, so it is the one setting whose old value cannot
# be changed by redeploying: moving the app means keeping a permanent redirect
# from here rather than reprinting the estate.
#
# Uppercased before it is encoded, and it must stay within what QR alphanumeric
# mode can carry -- digits, A-Z and $%*+-./: -- so an underscore in a hostname
# is refused rather than silently printed as a larger symbol. Length matters
# too: a longer host is a bigger symbol on the same sticker, and printing fails
# rather than producing labels too fine to scan. See
# backend/src/inventory/labels.py.
LABEL_BASE_URL=https://inventory.nycmesh.net

# --- Database -------------------------------------------------------------
# The host is "postgres" only for a Django running inside the compose stack --
# the service name, on the container network. Every other arrangement reaches
# it through the port published on this machine and so says "localhost": the
# usual development setup, where compose runs PostgreSQL and Django runs
# natively; a PostgreSQL installed directly; and the test suites.
DATABASE_URL=postgres://inventory:inventory@localhost:5432/inventory_tng

# How many seconds to wait for a database that is not answering before giving
# up on it. Five, and the direction that usually hurts is upwards.
#
# Left unbounded the wait belongs to the operating system, which goes on
# retrying a handshake nobody will answer for minutes. Long before that a
# gunicorn worker is killed for taking too long, having served nobody the
# whole time -- and a database whose address has moved, in a failover or a
# lost node, is exactly when the fewest workers can be spared. What that costs
# a cluster, and the ceiling this figure must stay under, are worked out in
# docs/deployment.md#health-checks.
#
# It is not impatience. A connect to a healthy PostgreSQL on the same network
# is a matter of milliseconds, so five seconds is hundreds of times what the
# operation takes and cannot be reached while the database is in contact --
# which is the point, since a fast answer is worth more than a patient one
# exactly when there is nothing to be patient with.
#
# Two things it covers that are easy to miss, and both argue for measuring
# rather than assuming on a deployment unlike this one:
#
#   The clock runs from the first DNS lookup to the end of authentication, so
#   name resolution, TLS and the password exchange are all inside the budget.
#   A managed database across a zone, reached over TLS, spends far more of the
#   five than a container on this machine does.
#
#   A host that resolves to several addresses gets the whole of it EACH, so
#   two addresses is a wait of ten. That is ordinary rather than exotic: a
#   multi-zone endpoint, a dual-stack Service, or a URL naming two hosts.
#
# So a deployment where a healthy connect genuinely takes longer should raise
# this -- and read the ceiling first, because raising it alone is what the
# deployment document says not to do.
#
# Downwards it is refused rather than obeyed: the driver reads nought, and
# anything negative, as no limit at all, and quietly rounds one up to two. So
# anything under two stops the process at boot naming this variable, instead
# of removing the bound it was set to tighten.
#
# Every request meets it and not only the health probes, because connections
# are not pooled and each request dials afresh. A volunteer submitting a batch
# during an outage is told so in seconds rather than watching a spinner, and
# the batch waits in the app's outbox until the database is back.
#
# A connect_timeout written into DATABASE_URL above wins over this, since a
# value somebody typed against one database should not be overruled by a
# default meant for all of them. It is held to the same floor.
DATABASE_CONNECT_TIMEOUT_SECONDS=5

# Which port on this machine compose publishes PostgreSQL on. Change it when
# something else already holds 5432, which is the ordinary state of a laptop
# that has run another project's database.
#
# These two have to agree: this is the port the container is reachable on and
# DATABASE_URL above is where Django goes looking. Moving one alone points
# Django at whatever else is on 5432 -- a cluster that is not this project's,
# and which will fail to authenticate or, worse, will not.
POSTGRES_PORT=5432

# What the compose database calls itself, and who connects to it. These three
# are the postgres image's own variables: it reads them once, on the very first
# start, to create the cluster. Changing one afterwards does NOT rename
# anything -- it changes who the container tries to be, against a database
# still holding the old names, and the symptom is an authentication failure
# with everything apparently configured correctly. `compose down -v` and start
# again is what actually applies a change.
#
# They also have to agree with DATABASE_URL above, which is where Django goes
# looking; the URL is not derived from them.
#
# The password is `inventory` on purpose. This database exists on a laptop,
# holds invented data, and is published on a port only that laptop can reach. A
# deployment supplies its own through a Secret and none of these three are read
# there -- docs/deployment.md#environment-variables is that side.
POSTGRES_DB=inventory_tng
POSTGRES_USER=inventory
POSTGRES_PASSWORD=inventory

# --- Frontend -------------------------------------------------------------
# Where the Vite dev server forwards Django's paths during development. In
# production nginx does this forwarding instead, so no API URL is ever baked
# into the JavaScript bundle -- see docs/deployment.md.
VITE_API_BASE_URL=http://localhost:8000
