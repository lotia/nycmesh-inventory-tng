# Local development environment.
#
# Copy to .env and adjust:  cp .env.sample .env
# Consumed by both docker compose and the Django settings module.
# Kubernetes supplies these same variables from ConfigMaps and Secrets --
# see docs/deployment.md for the production values of each.

# --- Django ---------------------------------------------------------------
# No default: a missing secret must fail loudly rather than start insecurely.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=dev-only-not-for-deployment-change-me

# Never true outside local development.
DJANGO_DEBUG=true

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Origins allowed to call the API from a browser. The Vite dev server runs
# on 5173.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Origins allowed to WRITE. Django checks the browser's Origin header on every
# unsafe request, and the dev server is a different origin from the backend it
# proxies to, so without this every POST from `npm run dev` is a 403. Left
# unset it follows CORS_ALLOWED_ORIGINS above, which is what you want locally;
# set it only to allow a different set of origins to write than to read.
# CSRF_TRUSTED_ORIGINS=

# --- Database -------------------------------------------------------------
# Host is "postgres" under docker compose, "localhost" when running Postgres
# directly on your machine.
DATABASE_URL=postgres://inventory:inventory@localhost:5432/inventory_tng

POSTGRES_DB=inventory_tng
POSTGRES_USER=inventory
POSTGRES_PASSWORD=inventory

# --- Frontend -------------------------------------------------------------
# Where the Vite dev server forwards /api during development. In production
# nginx does this forwarding instead, so no API URL is ever baked into the
# JavaScript bundle -- see docs/deployment.md.
VITE_API_BASE_URL=http://localhost:8000
